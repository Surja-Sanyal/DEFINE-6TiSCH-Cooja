  <plugin>
    org.contikios.cooja.plugins.ScriptRunner
    <plugin_config>
      <script>
        TIMEOUT(3600000);
        var joined = 0;
        var target = 100;
        while (joined &lt; target) {
          YIELD();
          if (msg.contains("CSV_JOIN")) {
            log.log(msg + "\n");
            joined++;
          }
        }
        log.testOK();
      </script>
      <active>true</active>
    </plugin_config>
  </plugin>
